{
  "openapi": "3.1.0",
  "info": {
    "title": "AmbuSync backend — etapa 1",
    "version": "1.0.0",
    "description": "Contrato local para cuentas demo, hospitales de ejemplo y campos de prueba. No es una API clínica ni autoriza despliegue."
  },
  "servers": [{ "url": "http://127.0.0.1:8000" }],
  "paths": {
    "/api/v1/auth/csrf/": {
      "get": {
        "operationId": "getCsrfToken",
        "responses": {
          "200": {
            "description": "Emite cookie csrftoken y token para el encabezado de mutaciones.",
            "content": { "application/json": { "schema": { "type": "object", "required": ["csrf_token"], "properties": { "csrf_token": { "type": "string" } } } } }
          }
        }
      }
    },
    "/api/v1/auth/login/": {
      "post": {
        "operationId": "login",
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string", "format": "password" } }, "additionalProperties": false } } }
        },
        "responses": {
          "200": { "description": "Sesión iniciada.", "headers": { "Set-Cookie": { "$ref": "#/components/headers/SessionCookie" } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/auth/logout/": {
      "post": {
        "operationId": "logout",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "responses": {
          "204": { "description": "Sesión cerrada." },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/auth/me/": {
      "get": {
        "operationId": "getCurrentUser",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/UserInteraction" }],
        "responses": {
          "200": { "description": "Cuenta, ámbitos y vencimientos de sesión.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CurrentUser" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/auth/activate/": {
      "post": {
        "operationId": "activateAccount",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountActivation" } } } },
        "responses": {
          "200": { "description": "Cuenta activada; no inicia sesión automáticamente." },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/institutions/destinations/": {
      "get": {
        "operationId": "listDestinations",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/UserInteraction" }],
        "responses": {
          "200": { "description": "Destinos receptores habilitados para la cuenta de ambulancia.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Destination" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/institutions/management/accounts/": {
      "get": {
        "operationId": "listInstitutionAccounts",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "description": "Cuentas de la institución activa del administrador.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ManagedAccount" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createInstitutionAccount",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManagedAccountCreate" } } } },
        "responses": {
          "201": { "description": "Cuenta pendiente creada; correo de activación enviado.", "content": { "application/json": { "schema": { "type": "object", "required": ["id", "username", "activation_sent"], "properties": { "id": { "type": "string" }, "username": { "type": "string" }, "activation_sent": { "type": "boolean", "const": true } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "description": "No se pudo enviar la activación; la creación fue revertida." }
        }
      }
    },
    "/api/v1/institutions/management/accounts/{user_id}/deactivate/": {
      "post": {
        "operationId": "deactivateInstitutionAccount",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/ManagedUserId" }],
        "responses": { "204": { "description": "Cuenta desactivada; sesiones y asignación revocadas." }, "400": { "$ref": "#/components/responses/BadRequest" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/v1/institutions/management/accounts/{user_id}/resend-activation/": {
      "post": {
        "operationId": "resendInstitutionAccountActivation",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/ManagedUserId" }],
        "responses": { "200": { "description": "Enlace de activación rotado y reenviado." }, "400": { "$ref": "#/components/responses/BadRequest" }, "403": { "$ref": "#/components/responses/Forbidden" }, "503": { "description": "No se pudo enviar el correo; cambios revertidos." } }
      }
    },
    "/api/v1/institutions/management/ambulances/": {
      "get": {
        "operationId": "listInstitutionAmbulances",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Unidades habilitadas de instituciones operadoras; solo las consulta administración de Urgencias.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ManagedAmbulance" } } } } }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/v1/institutions/management/config/": {
      "get": {
        "operationId": "getInstitutionAccountManagementConfig",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Nombre del establecimiento y permisos delegables según su tipo.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountManagementConfig" } } } }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/v1/emergencies/": {
      "get": {
        "operationId": "listEmergencies",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
          { "$ref": "#/components/parameters/UserInteraction" }
        ],
        "responses": {
          "200": { "description": "Página dentro del ámbito autorizado.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmergencyPage" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createEmergency",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/UserInteraction" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmergencyCreate" } } } },
        "responses": {
          "201": { "description": "Episodio persistido.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Emergency" } } } },
          "200": { "description": "Reintento idempotente; incluye Idempotent-Replay: true.", "headers": { "Idempotent-Replay": { "schema": { "type": "string", "const": "true" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Emergency" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/emergencies/{emergency_id}/": {
      "get": {
        "operationId": "getEmergency",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "name": "emergency_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/UserInteraction" }],
        "responses": {
          "200": { "description": "Episodio si pertenece al ámbito autorizado.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Emergency" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "sessionid" } },
    "parameters": {
      "CsrfToken": { "name": "X-CSRFToken", "in": "header", "required": true, "schema": { "type": "string" }, "description": "Valor obtenido en GET /api/v1/auth/csrf/." },
      "ManagedUserId": { "name": "user_id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "UserInteraction": { "name": "X-AmbuSync-User-Interaction", "in": "header", "required": false, "schema": { "type": "string", "enum": ["1"] }, "description": "Enviar solo para acción humana; omitir en polling/telemetría. Renueva el vencimiento de inactividad (30 min), nunca el límite absoluto de 12 h." }
    },
    "headers": { "SessionCookie": { "description": "Cookie HttpOnly de sesión; Secure se activa para HTTPS.", "schema": { "type": "string" } } },
    "responses": {
      "BadRequest": { "description": "Validación fallida.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Credenciales inválidas o cuenta no disponible.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "CSRF inválido o acción no autorizada.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Recurso no disponible dentro del ámbito.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "El UUID de operación fue reutilizado con otro contenido.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "TooManyRequests": { "description": "Umbral por cuenta u origen excedido; reintentar después de Retry-After.", "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 1 } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["code", "message", "fields", "correlation_id"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "fields": { "type": "object", "additionalProperties": true },
          "correlation_id": { "type": "string", "format": "uuid" }
        }
      },
      "CurrentUser": {
        "type": "object",
        "required": ["id", "username", "groups", "institutions", "session"],
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "groups": { "type": "array", "items": { "type": "string" } },
          "institutions": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } } } },
          "session": { "type": "object", "required": ["started_at", "idle_expires_at", "absolute_expires_at"], "properties": { "started_at": { "type": "number", "description": "Unix timestamp en segundos." }, "idle_expires_at": { "type": "number", "description": "Expiración por inactividad; 30 minutos tras interacción humana." }, "absolute_expires_at": { "type": "number", "description": "Expiración absoluta; máximo 12 horas desde el inicio." } } }
        }
      },
      "ManagedAccount": {
        "type": "object",
        "required": ["id", "username", "email", "institution_name", "groups", "active", "ambulance"],
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "institution_name": { "type": "string" },
          "groups": { "type": "array", "items": { "type": "string" } },
          "active": { "type": "boolean" },
          "ambulance": { "oneOf": [{ "$ref": "#/components/schemas/ManagedAmbulance" }, { "type": "null" }] }
        }
      },
      "ManagedAmbulance": { "type": "object", "required": ["id", "code", "institution_id", "institution_name"], "properties": { "id": { "type": "string", "format": "uuid" }, "code": { "type": "string" }, "institution_id": { "type": "string", "format": "uuid" }, "institution_name": { "type": "string" } } },
      "ManagedInstitution": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } } },
      "AccountManagementConfig": { "type": "object", "required": ["institution_name", "delegable_groups", "operator_institutions", "can_create_accounts"], "properties": { "institution_name": { "type": "string" }, "delegable_groups": { "type": "array", "items": { "type": "string", "enum": ["ambulance", "urgencias"] } }, "operator_institutions": { "type": "array", "items": { "$ref": "#/components/schemas/ManagedInstitution" } }, "can_create_accounts": { "type": "boolean" } } },
      "ManagedAccountCreate": {
        "type": "object",
        "required": ["username", "email", "groups"],
        "additionalProperties": false,
        "properties": {
          "username": { "type": "string", "minLength": 1, "maxLength": 150 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "groups": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["ambulance", "urgencias"] } },
          "ambulance_id": { "type": "string", "format": "uuid", "description": "Obligatorio si groups contiene ambulance; debe pertenecer a institution_id." },
          "institution_id": { "type": "string", "format": "uuid", "description": "Obligatorio para cuentas ambulance; la administración de Urgencias solo puede elegir instituciones operadoras habilitadas." }
        }
      },
      "AccountActivation": {
        "type": "object",
        "required": ["uid", "token", "password", "password_confirmation"],
        "additionalProperties": false,
        "properties": {
          "uid": { "type": "string" },
          "token": { "type": "string" },
          "password": { "type": "string", "format": "password", "minLength": 15, "maxLength": 128 },
          "password_confirmation": { "type": "string", "format": "password", "minLength": 15, "maxLength": 128 }
        }
      },
      "Destination": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } } },
      "EmergencyCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "destination_id", "patient_identity_unknown", "reason"],
        "properties": {
          "operation_id": { "type": "string", "format": "uuid" },
          "destination_id": { "type": "string", "format": "uuid" },
          "transfer_started": { "type": "boolean", "default": false },
          "patient_identity_unknown": { "type": "boolean" },
          "patient_alias": { "type": "string", "maxLength": 160 },
          "age_value": { "type": ["integer", "null"], "minimum": 0, "maximum": 130 },
          "age_unit": { "type": "string", "enum": ["years", "months", "days", ""] },
          "recorded_sex": { "type": ["string", "null"], "enum": ["F", "M", "X", null] },
          "reason": { "type": "string", "minLength": 3, "maxLength": 2000 },
          "symptoms": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "maxLength": 120 } },
          "vitals": { "type": "object", "additionalProperties": false, "description": "Cada medición es opcional. taken_at es obligatorio si se incluye alguna medición; no enviar ni crear mediciones ausentes.", "properties": { "hr": { "type": ["integer", "null"], "minimum": 0 }, "bp_sys": { "type": ["integer", "null"], "minimum": 0 }, "bp_dia": { "type": ["integer", "null"], "minimum": 0 }, "spo2": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }, "rr": { "type": ["integer", "null"], "minimum": 0 }, "temp_c": { "type": ["number", "null"] }, "glasgow": { "type": ["integer", "null"], "minimum": 3, "maximum": 15 }, "taken_at": { "type": "string", "format": "date-time" } } },
          "notes": { "type": "string", "maxLength": 2000 },
          "triage": { "type": "string", "enum": ["C1", "C2", "C3", "C4", "C5", ""] }
        }
      },
      "Emergency": {
        "type": "object",
        "required": ["id", "operating_institution_id", "destination_id", "destination_name", "ambulance_id", "ambulance_code", "status", "patient", "reason", "symptoms", "notes", "vital_measurements", "triage", "created_at", "transfer_declared_at", "version"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "operating_institution_id": { "type": "string", "format": "uuid" },
          "destination_id": { "type": "string", "format": "uuid" },
          "destination_name": { "type": "string" },
          "ambulance_id": { "type": "string", "format": "uuid" },
          "ambulance_code": { "type": "string" },
          "status": { "type": "string", "enum": ["notificada", "en_traslado"] },
          "patient": { "type": "object", "required": ["identity_unknown", "alias", "age_value", "age_unit", "recorded_sex"], "properties": { "identity_unknown": { "type": "boolean" }, "alias": { "type": ["string", "null"] }, "age_value": { "type": ["integer", "null"] }, "age_unit": { "type": ["string", "null"] }, "recorded_sex": { "type": ["string", "null"] } } },
          "reason": { "type": "string" },
          "symptoms": { "type": "array", "items": { "type": "string" } },
          "vital_measurements": { "type": "array", "items": { "type": "object", "required": ["kind", "value", "unit", "measured_at", "recorded_at", "recorded_by_id"], "properties": { "kind": { "type": "string", "enum": ["heart_rate", "systolic_pressure", "diastolic_pressure", "spo2", "respiratory_rate", "temperature", "glasgow"] }, "value": { "type": "number" }, "unit": { "type": "string" }, "measured_at": { "type": "string", "format": "date-time" }, "recorded_at": { "type": "string", "format": "date-time" }, "recorded_by_id": { "type": "string" } } } },
          "notes": { "type": "string" },
          "triage": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" },
          "transfer_declared_at": { "type": ["string", "null"], "format": "date-time" },
          "version": { "type": "integer", "minimum": 1 }
        }
      },
      "EmergencyPage": {
        "type": "object",
        "required": ["count", "next", "previous", "results"],
        "properties": {
          "count": { "type": "integer" },
          "next": { "type": ["string", "null"] },
          "previous": { "type": ["string", "null"] },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/Emergency" } }
        }
      }
    }
  }
}
