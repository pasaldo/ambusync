{
  "openapi": "3.1.0",
  "info": {
    "title": "AmbuSync backend — etapa 1",
    "version": "1.0.0",
    "description": "Contrato local para cuentas demo, hospitales de ejemplo y campos de prueba. No es una API clínica ni autoriza despliegue."
  },
  "servers": [{ "url": "http://127.0.0.1:8000" }],
  "paths": {
    "/api/v1/auth/csrf/": {
      "get": {
        "operationId": "getCsrfToken",
        "responses": {
          "200": {
            "description": "Emite cookie csrftoken y token para el encabezado de mutaciones.",
            "content": { "application/json": { "schema": { "type": "object", "required": ["csrf_token"], "properties": { "csrf_token": { "type": "string" } } } } }
          }
        }
      }
    },
    "/api/v1/auth/login/": {
      "post": {
        "operationId": "login",
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string", "format": "password" } }, "additionalProperties": false } } }
        },
        "responses": {
          "200": { "description": "Sesión iniciada.", "headers": { "Set-Cookie": { "$ref": "#/components/headers/SessionCookie" } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/auth/logout/": {
      "post": {
        "operationId": "logout",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "responses": {
          "204": { "description": "Sesión cerrada." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/auth/me/": {
      "get": {
        "operationId": "getCurrentUser",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/UserInteraction" }],
        "responses": {
          "200": { "description": "Cuenta, ámbitos, unidad asignada y vencimientos de sesión.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CurrentUser" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/auth/activate/": {
      "post": {
        "operationId": "activateAccount",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountActivation" } } } },
        "responses": {
          "200": { "description": "Cuenta activada; no inicia sesión automáticamente." },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/institutions/destinations/": {
      "get": {
        "operationId": "listDestinations",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/UserInteraction" }],
        "responses": {
          "200": { "description": "Destinos receptores habilitados para la cuenta de ambulancia.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Destination" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/institutions/management/accounts/": {
      "get": {
        "operationId": "listInstitutionAccounts",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "description": "Cuentas de la institución activa del administrador.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ManagedAccount" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createInstitutionAccount",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManagedAccountCreate" } } } },
        "responses": {
          "201": { "description": "Cuenta pendiente creada; correo de activación enviado.", "content": { "application/json": { "schema": { "type": "object", "required": ["id", "username", "activation_sent"], "properties": { "id": { "type": "string" }, "username": { "type": "string" }, "activation_sent": { "type": "boolean", "const": true } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/institutions/management/accounts/{user_id}/deactivate/": {
      "post": {
        "operationId": "deactivateInstitutionAccount",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/ManagedUserId" }],
        "responses": { "204": { "description": "Cuenta desactivada; sesiones y asignación revocadas." }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v1/institutions/management/accounts/{user_id}/resend-activation/": {
      "post": {
        "operationId": "resendInstitutionAccountActivation",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/ManagedUserId" }],
        "responses": { "200": { "description": "Enlace de activación rotado y reenviado." }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } }
      }
    },
    "/api/v1/institutions/management/ambulances/": {
      "get": {
        "operationId": "listInstitutionAmbulances",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "name": "include_disabled", "in": "query", "schema": { "type": "string", "enum": ["true", "false"], "default": "false" } }],
        "responses": { "200": { "description": "Unidades habilitadas de instituciones operadoras; solo las consulta administración de Urgencias.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ManagedAmbulance" } } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/v1/institutions/management/config/": {
      "get": {
        "operationId": "getInstitutionAccountManagementConfig",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Nombre del establecimiento y permisos delegables según su tipo.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountManagementConfig" } } } }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/v1/institutions/management/ambulances/create/": {
      "post": {
        "operationId": "createInstitutionAmbulance",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["institution_id", "code"], "properties": { "institution_id": { "type": "string", "format": "uuid" }, "code": { "type": "string", "minLength": 1, "maxLength": 40 } } } } } },
        "responses": { "201": { "description": "Unidad creada y auditada en una operadora habilitada.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManagedAmbulance" } } } }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/api/v1/institutions/management/accounts/{user_id}/assignment/": {
      "post": {
        "operationId": "changeInstitutionAccountAssignment",
        "description": "Asignar/reasignar dentro de la institución del operador o retirar mediante null explícito. expected_ambulance_id contiene la unidad observada o null. Repetir el destino ya vigente es no-op; otra edición obsoleta devuelve 409. No permite dejar sin operador habilitado una unidad con episodios no terminales (notificada, en_traslado, llegado).",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/ManagedUserId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["ambulance_id", "expected_ambulance_id"], "properties": { "ambulance_id": { "type": ["string", "null"], "format": "uuid" }, "expected_ambulance_id": { "type": ["string", "null"], "format": "uuid" } } } } } },
        "responses": { "200": { "description": "Unidad asignada o ya vigente.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssignmentUnit" } } } }, "204": { "description": "Asignación retirada o ya retirada; cuenta conservada." }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "description": "La asignación cambió; actualizar antes de decidir." } }
      }
    },
    "/api/v1/institutions/management/ambulances/{ambulance_id}/deactivate/": {
      "post": {
        "operationId": "deactivateInstitutionAmbulance",
        "description": "Baja lógica auditada, termina asignaciones sin borrar histórico. Requiere institución combinada propia, relación explícita con la operadora o creación auditada por el actor. El directorio legado compartido no concede baja. Idempotente si ya está desactivada.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "name": "ambulance_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "maxProperties": 0 } } } },
        "responses": { "204": { "description": "Unidad desactivada o ya desactivada." }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v1/system/institutions/": {
      "get": {
        "operationId": "listSystemInstitutions",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["all", "active", "inactive"], "default": "all" } },
          { "name": "q", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Busca por nombre o RUT." }
        ],
        "responses": {
          "200": { "description": "Todas las instituciones disponibles para administración global, incluidas las inactivas.", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/SystemInstitution" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createSystemInstitution",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/UserInteraction" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SystemInstitutionCreate" } } } },
        "responses": {
          "201": { "description": "Institución operadora y receptora (tipo combined), cuenta Urgencias con administración institucional y activación local creadas.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SystemInstitutionCreated" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/system/institutions/{institution_id}/": {
      "patch": {
        "operationId": "updateSystemInstitution",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/SystemInstitutionId" }, { "$ref": "#/components/parameters/UserInteraction" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SystemInstitutionUpdate" } } } },
        "responses": {
          "200": { "description": "Datos institucionales actualizados; tipo y estado no se modifican en esta operación.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SystemInstitution" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/system/institutions/{institution_id}/deactivate/": {
      "post": {
        "operationId": "deactivateSystemInstitution",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/SystemInstitutionId" }, { "$ref": "#/components/parameters/UserInteraction" }],
        "responses": {
          "200": { "description": "Baja lógica completada; sesiones de miembros revocadas.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SystemInstitution" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/system/institutions/{institution_id}/reactivate/": {
      "post": {
        "operationId": "reactivateSystemInstitution",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/SystemInstitutionId" }, { "$ref": "#/components/parameters/UserInteraction" }],
        "responses": {
          "200": { "description": "Institución reactivada sin eliminar historial ni membresías.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SystemInstitution" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/emergencies/": {
      "get": {
        "operationId": "listEmergencies",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
          { "$ref": "#/components/parameters/UserInteraction" }
        ],
        "responses": {
          "200": { "description": "Página dentro del ámbito autorizado.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmergencyPage" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createEmergency",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "$ref": "#/components/parameters/UserInteraction" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmergencyCreate" } } } },
        "responses": {
          "201": { "description": "Episodio persistido.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Emergency" } } } },
          "200": { "description": "Reintento idempotente; incluye Idempotent-Replay: true.", "headers": { "Idempotent-Replay": { "schema": { "type": "string", "const": "true" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Emergency" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/emergencies/{emergency_id}/": {
      "get": {
        "operationId": "getEmergency",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "name": "emergency_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/UserInteraction" }],
        "responses": {
          "200": { "description": "Episodio si pertenece al ámbito autorizado.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Emergency" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/emergencies/{emergency_id}/arrival/": {
      "post": {
        "operationId": "confirmEmergencyArrival",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CsrfToken" },
          { "name": "emergency_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "$ref": "#/components/parameters/UserInteraction" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArrivalConfirmation" } } }
        },
        "responses": {
          "200": { "description": "Llegada confirmada; una repetición idempotente devuelve el episodio sin duplicar auditoría.", "headers": { "Idempotent-Replay": { "schema": { "type": "string", "const": "true" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Emergency" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/emergencies/{emergency_id}/update/": {
      "post": {
        "operationId": "updateEmergencyBackground",
        "description": "Solo integrante habilitado de la unidad, antes de recepción. Omisión conserva datos; triage null/vacío retira clasificación. Autor/fecha servidor y auditoría. No modifica identidad del paciente ni destino. Replay exacto no incrementa versión aunque haya llegado después, siempre dentro de ámbito.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "name": "emergency_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/UserInteraction" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmergencyUpdate" } } } },
        "responses": { "200": { "$ref": "#/components/responses/TransitionSuccess" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" } }
      }
    },
    "/api/v1/emergencies/{emergency_id}/measurements/": {
      "post": {
        "operationId": "appendEmergencyMeasurements",
        "description": "Agrega una serie antes de recepción sin sobrescribir muestras. Al menos un valor no nulo y taken_at con zona explícita. Un lote aumenta versión una vez. Cada fila conserva autor, hora medida, hora servidor y UUID operación. No inventa valores ausentes.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "name": "emergency_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/UserInteraction" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmergencyMeasurements" } } } },
        "responses": { "200": { "$ref": "#/components/responses/TransitionSuccess" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" } }
      }
    },
    "/api/v1/emergencies/{emergency_id}/measurements/rectify/": {
      "post": {
        "operationId": "rectifyEmergencyMeasurement",
        "description": "Crea reemplazo vinculado con motivo obligatorio, mismo tipo/unidad canónica, antes de recepción. Original intacta y consultable. Solo hoja sin reemplazo de ese episodio; cadenas A→B→C permitidas, segunda rectificación de A devuelve409. Reintento exacto conserva una única sustitución.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "name": "emergency_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/UserInteraction" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmergencyRectification" } } } },
        "responses": { "200": { "$ref": "#/components/responses/TransitionSuccess" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" } }
      }
    },
    "/api/v1/emergencies/{emergency_id}/transfer-start/": {
      "post": {
        "operationId": "startEmergencyTransfer",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "name": "emergency_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/UserInteraction" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmergencyOperation" } } } },
        "responses": { "200": { "$ref": "#/components/responses/TransitionSuccess" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" } }
      }
    },
    "/api/v1/emergencies/{emergency_id}/cancel/": {
      "post": {
        "operationId": "cancelEmergency",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "name": "emergency_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/UserInteraction" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmergencyCancellation" } } } },
        "responses": { "200": { "$ref": "#/components/responses/TransitionSuccess" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" } }
      }
    },
    "/api/v1/emergencies/{emergency_id}/close/": {
      "post": {
        "operationId": "closeEmergency",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "name": "emergency_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "$ref": "#/components/parameters/UserInteraction" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmergencyOperation" } } } },
        "responses": { "200": { "$ref": "#/components/responses/TransitionSuccess" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "sessionid" } },
    "parameters": {
      "CsrfToken": { "name": "X-CSRFToken", "in": "header", "required": true, "schema": { "type": "string" }, "description": "Valor obtenido en GET /api/v1/auth/csrf/." },
      "ManagedUserId": { "name": "user_id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "SystemInstitutionId": { "name": "institution_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "UserInteraction": { "name": "X-AmbuSync-User-Interaction", "in": "header", "required": false, "schema": { "type": "string", "enum": ["1"] }, "description": "Enviar solo para acción humana; omitir en polling/telemetría. Renueva el vencimiento de inactividad (30 min), nunca el límite absoluto de 12 h." }
    },
    "headers": { "SessionCookie": { "description": "Cookie HttpOnly de sesión; Secure se activa para HTTPS.", "schema": { "type": "string" } } },
    "responses": {
      "BadRequest": { "description": "Validación fallida.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Credenciales inválidas o cuenta no disponible.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "CSRF inválido o acción no autorizada.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Recurso no disponible dentro del ámbito.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "Estado o UUID de operación incompatible con la acción solicitada.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ServiceUnavailable": { "description": "Dependencia temporalmente no disponible; la operación fue revertida.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "TransitionSuccess": { "description": "Transición confirmada o repetición idempotente; no duplica fecha ni auditoría.", "headers": { "Idempotent-Replay": { "schema": { "type": "string", "const": "true" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Emergency" } } } },
      "TooManyRequests": { "description": "Umbral por cuenta u origen excedido; reintentar después de Retry-After.", "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 1 } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["code", "message", "fields", "correlation_id"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "fields": { "type": "object", "additionalProperties": true },
          "correlation_id": { "type": "string", "format": "uuid" }
        }
      },
      "CurrentUser": {
        "type": "object",
        "required": ["id", "username", "groups", "institutions", "ambulance", "session"],
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "groups": { "type": "array", "items": { "type": "string" } },
          "institutions": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } } } },
          "ambulance": { "oneOf": [{ "type": "object", "required": ["id", "code", "institution_name"], "properties": { "id": { "type": "string", "format": "uuid" }, "code": { "type": "string" }, "institution_name": { "type": "string" } } }, { "type": "null" }] },
          "session": { "type": "object", "required": ["started_at", "idle_expires_at", "absolute_expires_at"], "properties": { "started_at": { "type": "number", "description": "Unix timestamp en segundos." }, "idle_expires_at": { "type": "number", "description": "Expiración por inactividad; 30 minutos tras interacción humana." }, "absolute_expires_at": { "type": "number", "description": "Expiración absoluta; máximo 12 horas desde el inicio." } } }
        }
      },
      "ManagedAccount": {
        "type": "object",
        "required": ["id", "username", "email", "institution_name", "institution_id", "groups", "active", "ambulance"],
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "institution_name": { "type": "string" },
          "institution_id": { "type": "string", "format": "uuid" },
          "groups": { "type": "array", "items": { "type": "string" } },
          "active": { "type": "boolean" },
          "ambulance": { "oneOf": [{ "$ref": "#/components/schemas/AssignmentUnit" }, { "type": "null" }] }
        }
      },
      "AssignmentUnit": { "type": "object", "required": ["id", "code"], "properties": { "id": { "type": "string", "format": "uuid" }, "code": { "type": "string" } } },
      "ManagedAmbulance": { "type": "object", "required": ["id", "code", "institution_id", "institution_name", "enabled", "can_deactivate"], "properties": { "id": { "type": "string", "format": "uuid" }, "code": { "type": "string" }, "institution_id": { "type": "string", "format": "uuid" }, "institution_name": { "type": "string" }, "enabled": { "type": "boolean" }, "can_deactivate": { "type": "boolean" } } },
      "ManagedInstitution": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } } },
      "SystemInstitution": {
        "type": "object",
        "required": ["id", "name", "kind", "enabled", "rut", "address", "phone", "email"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "maxLength": 160 },
          "kind": { "type": "string", "enum": ["operator", "receiver", "combined"] },
          "enabled": { "type": "boolean" },
          "rut": { "type": "string", "pattern": "^\\d{2}\\.\\d{3}\\.\\d{3}-[0-9K]$" },
          "address": { "type": "string", "maxLength": 255 },
          "phone": { "type": "string", "maxLength": 15 },
          "email": { "type": "string", "format": "email", "maxLength": 254 }
        }
      },
      "SystemInstitutionCreate": {
        "type": "object",
        "required": ["name", "rut", "address", "email", "first_username", "first_email"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160, "description": "Letras, números, espacios y guiones." },
          "rut": { "type": "string", "pattern": "^\\d{2}\\.\\d{3}\\.\\d{3}-[0-9K]$", "description": "RUT chileno con dígito módulo 11 y base entre 76.000.000 y 79.999.999." },
          "address": { "type": "string", "minLength": 1, "maxLength": 255 },
          "phone": { "type": "string", "maxLength": 15, "pattern": "^[0-9+ ()-]{0,15}$" },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "first_username": { "type": "string", "minLength": 1, "maxLength": 150 },
          "first_email": { "type": "string", "format": "email", "maxLength": 254 }
        }
      },
      "SystemInstitutionUpdate": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "rut": { "type": "string", "pattern": "^\\d{2}\\.\\d{3}\\.\\d{3}-[0-9K]$" },
          "address": { "type": "string", "minLength": 1, "maxLength": 255 },
          "phone": { "type": "string", "maxLength": 15, "pattern": "^[0-9+ ()-]{0,15}$" },
          "email": { "type": "string", "format": "email", "maxLength": 254 }
        }
      },
      "SystemInstitutionCreated": {
        "allOf": [
          { "$ref": "#/components/schemas/SystemInstitution" },
          {
            "type": "object",
            "required": ["first_account", "activation_sent"],
            "properties": {
              "first_account": { "type": "object", "required": ["id", "username"], "properties": { "id": { "type": "string" }, "username": { "type": "string" } } },
              "activation_sent": { "type": "boolean", "const": true }
            }
          }
        ]
      },
      "AccountManagementConfig": { "type": "object", "required": ["institution_name", "delegable_groups", "operator_institutions", "can_create_accounts"], "properties": { "institution_name": { "type": "string" }, "delegable_groups": { "type": "array", "items": { "type": "string", "enum": ["ambulance", "urgencias"] } }, "operator_institutions": { "type": "array", "items": { "$ref": "#/components/schemas/ManagedInstitution" } }, "can_create_accounts": { "type": "boolean" } } },
      "ManagedAccountCreate": {
        "type": "object",
        "required": ["username", "email", "groups"],
        "additionalProperties": false,
        "properties": {
          "username": { "type": "string", "minLength": 1, "maxLength": 150 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "groups": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["ambulance", "urgencias"] } },
          "ambulance_id": { "type": "string", "format": "uuid", "description": "Obligatorio si groups contiene ambulance; debe pertenecer a institution_id." },
          "institution_id": { "type": "string", "format": "uuid", "description": "Obligatorio para cuentas ambulance; la administración de Urgencias solo puede elegir instituciones operadoras habilitadas." }
        }
      },
      "AccountActivation": {
        "type": "object",
        "required": ["uid", "token", "password", "password_confirmation"],
        "additionalProperties": false,
        "properties": {
          "uid": { "type": "string" },
          "token": { "type": "string" },
          "password": { "type": "string", "format": "password", "minLength": 15, "maxLength": 128 },
          "password_confirmation": { "type": "string", "format": "password", "minLength": 15, "maxLength": 128 }
        }
      },
      "Destination": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } } },
      "EmergencyCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "destination_id", "patient_identity_unknown", "reason"],
        "properties": {
          "operation_id": { "type": "string", "format": "uuid" },
          "destination_id": { "type": "string", "format": "uuid" },
          "transfer_started": { "type": "boolean", "default": false },
          "patient_identity_unknown": { "type": "boolean" },
          "patient_alias": { "type": "string", "maxLength": 160 },
          "age_value": { "type": ["integer", "null"], "minimum": 0, "maximum": 130 },
          "age_unit": { "type": "string", "enum": ["years", "months", "days", ""] },
          "recorded_sex": { "type": ["string", "null"], "enum": ["F", "M", "X", null] },
          "reason": { "type": "string", "minLength": 3, "maxLength": 2000 },
          "symptoms": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "maxLength": 120 } },
          "vitals": { "type": "object", "additionalProperties": false, "description": "Cada medición es opcional. taken_at es obligatorio si se incluye alguna medición; no enviar ni crear mediciones ausentes.", "properties": { "hr": { "type": ["integer", "null"], "minimum": 0 }, "bp_sys": { "type": ["integer", "null"], "minimum": 0 }, "bp_dia": { "type": ["integer", "null"], "minimum": 0 }, "spo2": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }, "rr": { "type": ["integer", "null"], "minimum": 0 }, "temp_c": { "type": ["number", "null"] }, "glasgow": { "type": ["integer", "null"], "minimum": 3, "maximum": 15 }, "taken_at": { "type": "string", "format": "date-time" } } },
          "notes": { "type": "string", "maxLength": 2000 },
          "triage": { "type": "string", "enum": ["C1", "C2", "C3", "C4", "C5", ""] }
        }
      },
      "ArrivalConfirmation": {
        "type": "object",
        "required": ["operation_id", "expected_version"],
        "additionalProperties": false,
        "properties": {
          "operation_id": { "type": "string", "format": "uuid" },
          "expected_version": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "maxLength": 2000, "description": "Obligatorio al confirmar llegada desde notificada (sin inicio de traslado registrado)." }
        }
      },
      "EmergencyOperation": { "type": "object", "required": ["operation_id", "expected_version"], "additionalProperties": false, "properties": { "operation_id": { "type": "string", "format": "uuid" }, "expected_version": { "type": "integer", "minimum": 1 } } },
      "EmergencyUpdate": { "type": "object", "required": ["operation_id", "expected_version"], "additionalProperties": false, "anyOf": [{ "required": ["reason"] }, { "required": ["symptoms"] }, { "required": ["notes"] }, { "required": ["triage"] }], "properties": { "operation_id": { "type": "string", "format": "uuid" }, "expected_version": { "type": "integer", "minimum": 1 }, "reason": { "type": "string", "minLength": 3, "maxLength": 2000 }, "notes": { "type": "string", "maxLength": 2000 }, "symptoms": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }, "triage": { "type": ["string", "null"], "enum": ["C1", "C2", "C3", "C4", "C5", "", null] } } },
      "EmergencyMeasurements": { "type": "object", "required": ["operation_id", "expected_version", "vitals"], "additionalProperties": false, "properties": { "operation_id": { "type": "string", "format": "uuid" }, "expected_version": { "type": "integer", "minimum": 1 }, "vitals": { "allOf": [{ "$ref": "#/components/schemas/EmergencyCreate/properties/vitals" }, { "required": ["taken_at"], "minProperties": 2 }], "description": "Al menos una medición no nula. Fecha con zona explícita; enteros y límites D-007. Capacidad de almacenamiento: hasta seis dígitos enteros; no es un rango clínico." } } },
      "EmergencyRectification": {
        "type": "object", "required": ["operation_id", "expected_version", "measurement_id", "value", "unit", "measured_at", "reason"], "additionalProperties": false,
        "properties": {
          "operation_id": { "type": "string", "format": "uuid" },
          "expected_version": { "type": "integer", "minimum": 1 },
          "measurement_id": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$", "description": "ID positivo de la fila; admite la cadena decimal devuelta por el historial." },
          "value": { "type": "number", "description": "Reglas D-007 según tipo original; finito, hasta dos decimales, temperatura uno; almacenamiento limitado, sin rangos clínicos adicionales." },
          "unit": { "type": "string", "enum": ["lpm", "mmHg", "%", "rpm", "°C", "puntos"] },
          "measured_at": { "type": "string", "format": "date-time" },
          "reason": { "type": "string", "minLength": 3, "maxLength": 2000 }
        }
      },
      "EmergencyCancellation": { "type": "object", "required": ["operation_id", "expected_version", "reason"], "additionalProperties": false, "properties": { "operation_id": { "type": "string", "format": "uuid" }, "expected_version": { "type": "integer", "minimum": 1 }, "reason": { "type": "string", "minLength": 3, "maxLength": 2000 } } },
      "Emergency": {
        "type": "object",
        "required": ["id", "operating_institution_id", "destination_id", "destination_name", "ambulance_id", "ambulance_code", "status", "patient", "reason", "symptoms", "notes", "vital_measurements", "triage", "created_at", "transfer_declared_at", "transfer_declared_by_id", "arrived_at", "arrived_by_id", "arrival_reason", "cancelled_at", "cancelled_by_id", "cancellation_reason", "closed_at", "closed_by_id", "version"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "operating_institution_id": { "type": "string", "format": "uuid" },
          "destination_id": { "type": "string", "format": "uuid" },
          "destination_name": { "type": "string" },
          "ambulance_id": { "type": "string", "format": "uuid" },
          "ambulance_code": { "type": "string" },
          "status": { "type": "string", "enum": ["notificada", "en_traslado", "llegado", "cancelada", "cerrada"] },
          "patient": { "type": "object", "required": ["identity_unknown", "alias", "age_value", "age_unit", "recorded_sex"], "properties": { "identity_unknown": { "type": "boolean" }, "alias": { "type": ["string", "null"] }, "age_value": { "type": ["integer", "null"] }, "age_unit": { "type": ["string", "null"] }, "recorded_sex": { "type": ["string", "null"] } } },
          "reason": { "type": "string" },
          "symptoms": { "type": "array", "items": { "type": "string" } },
          "vital_measurements": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "value", "unit", "measured_at", "recorded_at", "recorded_by_id", "operation_id", "rectifies_id", "rectified_by_id", "is_current", "rectification_reason"], "properties": { "id": { "type": "string" }, "kind": { "type": "string", "enum": ["heart_rate", "systolic_pressure", "diastolic_pressure", "spo2", "respiratory_rate", "temperature", "glasgow"] }, "value": { "type": "number" }, "unit": { "type": "string" }, "measured_at": { "type": "string", "format": "date-time" }, "recorded_at": { "type": "string", "format": "date-time" }, "recorded_by_id": { "type": "string" }, "operation_id": { "type": ["string", "null"], "format": "uuid" }, "rectifies_id": { "type": ["string", "null"] }, "rectified_by_id": { "type": ["string", "null"] }, "is_current": { "type": "boolean", "description": "No tiene reemplazo en su cadena; no implica que sea la última muestra temporal." }, "rectification_reason": { "type": "string" } } } },
          "notes": { "type": "string" },
          "triage": { "type": ["string", "null"] },
          "triage_recorded_at": { "type": ["string", "null"], "format": "date-time", "description": "Fecha servidor; null para legado sin inventar metadatos." },
          "triage_recorded_by_id": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" },
          "transfer_declared_at": { "type": ["string", "null"], "format": "date-time" },
          "transfer_declared_by_id": { "type": ["string", "null"] },
          "arrived_at": { "type": ["string", "null"], "format": "date-time" },
          "arrived_by_id": { "type": ["string", "null"] },
          "arrival_reason": { "type": "string" },
          "cancelled_at": { "type": ["string", "null"], "format": "date-time" },
          "cancelled_by_id": { "type": ["string", "null"] },
          "cancellation_reason": { "type": "string" },
          "closed_at": { "type": ["string", "null"], "format": "date-time" },
          "closed_by_id": { "type": ["string", "null"] },
          "version": { "type": "integer", "minimum": 1 }
        }
      },
      "EmergencyPage": {
        "type": "object",
        "required": ["count", "next", "previous", "results"],
        "properties": {
          "count": { "type": "integer" },
          "next": { "type": ["string", "null"] },
          "previous": { "type": ["string", "null"] },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/Emergency" } }
        }
      }
    }
  }
}
